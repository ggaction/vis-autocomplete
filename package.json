{
  "name": "ggaction-autocomplete",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "description": "Single-action visualization recommendations for ggaction, ranked by corpus co-occurrence.",
  "engines": {
    "node": ">=20"
  },
  "exports": "./src/index.js",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build:workers": "node scripts/build-workers.js",
    "benchmark:performance": "node scripts/benchmark-performance.js",
    "benchmark:recommendations": "node scripts/benchmark-lazy-recommendations.js",
    "demo": "node examples/demo.js",
    "test": "node scripts/test-suite.js",
    "corpus:update": "node scripts/update-corpus.js",
    "corpus:train": "node scripts/train-corpus.js",
    "catalog:check": "node scripts/check-catalog.js",
    "validate:corpus": "node scripts/validate-corpus.js",
    "validate:recommendations": "node scripts/validate-recommendations.js",
    "update": "node scripts/update.js",
    "check:ggaction": "git -C vendor/ggaction fetch origin",
    "test:ggaction": "npm --prefix vendor/ggaction run test:unit",
    "demo:initial": "node examples/initial-demo.js",
    "validate:initial": "node scripts/validate-initial.js",
    "audit:actions": "node scripts/audit-action-availability.js",
    "audit:coverage": "node scripts/audit-action-coverage.js",
    "audit:initial-options": "node scripts/audit-initial-options.js",
    "benchmark:session": "node scripts/benchmark-session.js",
    "test:composition": "node scripts/test-composition-browser.js",
    "benchmark:composition": "node scripts/benchmark-composition.js",
    "validate:corpus-programs": "node scripts/validate-corpus-programs.js",
    "test:layers": "node scripts/test-layer-composition-browser.js",
    "test:field-selection": "node --test test/field-selection.test.js && node scripts/test-field-selection-browser.js",
    "test:startup": "node scripts/test-dataset-startup-browser.js",
    "test:direct-editing": "node scripts/test-direct-deletion-browser.js",
    "build": "node scripts/build.js",
    "start": "node scripts/server.js",
    "test:cloud": "node --test test/cloud-*.test.js",
    "test:cloud-browser": "node scripts/test-cloud-browser.js"
  },
  "dependencies": {
    "@ggaction/transition": "file:vendor/transition",
    "@napi-rs/canvas": "^1.0.13",
    "@supabase/supabase-js": "^2.118.0",
    "acorn": "8.19.0",
    "ggaction": "file:vendor/ggaction",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.6"
  }
}
